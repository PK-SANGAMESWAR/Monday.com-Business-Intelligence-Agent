# Copy to .env and fill in. .env is gitignored; never commit a real token.

# --- Required ---------------------------------------------------------------
# monday.com personal access token.
# monday.com -> your avatar -> Developers -> My Access Tokens.
MONDAY_API_KEY=

# --- Required from F06 (the agent core), unless LLM_PROVIDER=ollama below ---
# console.anthropic.com -> API Keys. F01-F05 run without it.
ANTHROPIC_API_KEY=

# --- Optional: run the agent against a local model instead of Anthropic -----
# Set LLM_PROVIDER=ollama to test the agent before you have an Anthropic key
# (`ollama serve` + `ollama pull llama3.1`, or another tool-calling-capable
# model). Leave unset, or set back to "anthropic", to use ANTHROPIC_API_KEY -
# no other code or config changes needed either way.
# LLM_PROVIDER=anthropic
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_TIMEOUT_SECONDS=120.0

# --- Optional: populated by F03 once the boards exist ------------------------
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# --- Optional: defaults shown, uncomment to override -------------------------
# MONDAY_API_URL=https://api.monday.com/v2
# MONDAY_API_VERSION=2024-10
# BI_AGENT_MODEL=claude-sonnet-5
# CACHE_TTL_SECONDS=300
# HTTP_TIMEOUT_SECONDS=30.0
# MAX_RETRIES=3
# LOG_LEVEL=INFO
